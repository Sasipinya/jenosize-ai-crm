# Copy to .env.local (git-ignored) and fill in. Placeholders only: never put real values here.

# Postgres. Neon: use the POOLED connection string (host contains "-pooler") for the app and Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: direct (non-pooler) URL used only by `pnpm db:migrate` / `pnpm db:setup`. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
# Local: http://localhost:3000 · Vercel: your production URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Demo-only password for every seeded user (admin@example.com, sales@example.com, ...).
# Public on purpose (ADR 004). Must not match any real password you use anywhere.
SEED_DEMO_PASSWORD=DemoCRM-2026!

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Next.js telemetry is always disabled by scripts/next.mjs; set this too on Vercel.
NEXT_TELEMETRY_DISABLED=1

# Shared key for POST /api/public/leads (header x-api-key). Generate: openssl rand -hex 24
LEAD_INTAKE_API_KEY=replace-with-a-random-secret

# AI copilot (Anthropic Claude only). AI_ADAPTER=mock (default) needs no key: use it for dev, tests and CI.
# Set AI_ADAPTER=claude only when you want the real model; then ANTHROPIC_API_KEY is required.
AI_ADAPTER=mock
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
AI_MODEL=claude-haiku-5-5
# Optional price overrides (USD per million tokens) for the cost estimate in logs and eval reports.
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# Public base URL of this app, used in the LINE privacy notice link ({APP_URL}/privacy). No trailing slash.
# Falls back to NEXTAUTH_URL if empty.
APP_URL=http://localhost:3000

# LINE Messaging API. LINE_ADAPTER=mock (default) keeps messages in memory and never calls LINE: use it for dev, tests and CI.
# Set LINE_ADAPTER=real only for the demo; then the channel access token is required.
# LINE_CHANNEL_SECRET is needed in every mode: it verifies x-line-signature (and signs pnpm line:simulate).
LINE_ADAPTER=mock
LINE_CHANNEL_SECRET=replace-with-your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-your-line-channel-access-token

# Owner of new LINE leads: the user with this email. If empty or unknown, the first sales user is used.
LINE_DEFAULT_OWNER_EMAIL=sales@example.com
