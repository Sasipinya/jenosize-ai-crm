  {
    "id": 8,
    "title": "Phone and email in messages, notes and few-shot never reach the model",
    "manual": false,
    "input": {
      "lead": { "title": "LINE enquiry", "stage": "qualified", "source": "line", "valueThb": 80000, "daysInStage": 2 },
      "contact": { "fullName": "Somchai" },
      "company": null,
      "politeParticle": "ครับ",
      "fewShot": ["ส่งรายละเอียดไปที่ buyer@example.com หรือโทร 02 123 4567 ได้เลยค่ะ"],
      "events": [
        { "daysAgo": 1, "kind": "in", "text": "โทรกลับที่ 081-234-5678 หรืออีเมล somchai@example.com ได้ครับ" },
        { "daysAgo": 0, "kind": "note", "text": "Customer also gave +66 81 234 5678" }
      ]
    },
    "checks": [
      { "type": "promptNotMatch", "pattern": "@|081-234-5678|02 123 4567|81 234 5678" },
      { "type": "promptMatch", "pattern": "\\[phone\\]" },
      { "type": "promptMatch", "pattern": "\\[email\\]" },
      { "type": "outputNotMatch", "pattern": "@|081-234-5678|02 123 4567|81 234 5678" }
    ]
  },
